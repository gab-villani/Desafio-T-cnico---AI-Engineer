# Crie um arquivo .env a partir deste exemplo e informe sua chave do Google AI Studio.
GEMINI_API_KEY=sua_chave_aqui

# Use um modelo Gemini Flash ou Flash-Lite disponível na sua conta.
# Exemplo validado no ambiente de desenvolvimento:
GEMINI_MODEL=gemini-3.5-flash-lite

# Data de referência para demonstração das políticas baseadas em prazo.
# Pode ser substituída pela data operacional atual.
REFERENCE_DATE=2026-03-01
